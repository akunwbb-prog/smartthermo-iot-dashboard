# Server Configuration
NODE_ENV=development
PORT=3000

# JWT Secret - Generate strong random string for production
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRE=8h

# API Key for IoT Devices
IOT_API_KEY=smartthermo-iot-secret-key-change-this

# Admin Default Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=SmartThermo2024!

# Database
DATA_DIR=./data

# Application
APP_NAME=SmartThermo
APP_VERSION=2.0.0

# Logging
LOG_LEVEL=info
